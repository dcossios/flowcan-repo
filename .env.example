# Copiar a .env.local (nunca commitear). En Vercel van como Environment Variables.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/subase
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=./private.key
# OP_PRIVATE_KEY_B64=            # en Vercel: base64 -i private.key | tr -d '\n'
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EMPRESA_PIN=                 # PIN del panel de la empresa (/flota y gestión de vehículos)
# FLOTA_WALLET_ADDRESS=      # wallet que recibe los pagos; por defecto OP_CLIENT_WALLET_ADDRESS

# Solo para scripts/spike-pago.ts
SPIKE_PASAJERO_WALLET=https://ilp.interledger-test.dev/pasajero
SPIKE_VEHICULO_WALLET=https://ilp.interledger-test.dev/bus-01
SPIKE_MONTO=100          # tarifa en unidades mínimas (value escalado de la wallet del vehículo)
SPIKE_TOPE=1000          # tope diario del pase en unidades mínimas de la wallet del pasajero
SPIKE_PUERTO=3999
# SPIKE_SIN_QUOTE=1      # además prueba outgoingPayment.create con { incomingPayment, debitAmount }
